# Application Identity & Environment
APP_NAME="Dhaba Support Triage Service"
APP_ENV="development"

# Model Configuration
# MODEL_MODE options: "fixture" (default offline mode, no API key required) or "live"
MODEL_MODE="fixture"
MODEL_API_KEY=""
MODEL_NAME="gpt-4o-mini"
MODEL_BASE_URL=""
MODEL_TIMEOUT_SECONDS=2.5
LLM_TIMEOUT_SECONDS=2.5
LLM_FAILURE_THRESHOLD=5
LLM_RECOVERY_SECONDS=30.0
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=20

# Persistence Configuration
DATABASE_PATH="dhaba_triage.db"
